# ============================================================
# Chá da Alana — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# NUNCA publique valores reais no GitHub.
# ============================================================

# --- Supabase (obrigatório em produção) ---------------------
# Painel do Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública ("publishable" ou "anon") — pode ir ao navegador
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta ("secret" ou "service_role") — SOMENTE no servidor
SUPABASE_SECRET_KEY=

# --- Segurança ----------------------------------------------
# Texto aleatório com 32+ caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Endereço público do site (sem barra no final), usado nos links pessoais
SITE_URL=https://cha-da-alana.vercel.app
# Protege a rota /api/keepalive (o Cron da Vercel envia este valor automaticamente)
CRON_SECRET=

# --- Anti-robô no convite aberto (opcional, Cloudflare Turnstile, gratuito)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Avisos por e-mail (opcional, Resend) --------------------
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend, ex.: "Chá da Alana <avisos@seudominio.com.br>"
NOTIFY_FROM_EMAIL=

# --- WhatsApp Business Platform (opcional, pago por mensagem) -
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nome do modelo aprovado com 2 variáveis no corpo: {{1}} nome do convidado, {{2}} resumo
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_GRAPH_VERSION=v23.0

# --- Somente desenvolvimento local (sem Supabase) ------------
# Contas de teste do painel: "email|senha|Nome;email2|senha2|Nome2"
LOCAL_ADMINS=
